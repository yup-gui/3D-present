OPCUA_ENDPOINT          =  opc.tcp://192.168.0.1:4840         #OPC UA服务器的地址
OPCUA_POLL_INTERVAL     = 0.1                               #轮询OPC UA服务器的时间间隔
OPCUA_RETRY_INTERVAL    = 1.0                               #重试连接的时间间隔
OPCUA_MOCK_MODE         = False                             #是否使用模拟数据
LOG_LEVEL               = "INFO"                            #日志级别 DEBUG|INFO|WARNING